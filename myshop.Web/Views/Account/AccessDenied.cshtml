@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Access Denied</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <style>
            body {
                background: #f4f6f9;
            }

            .icon-circle {
                width: 120px;
                height: 120px;
                background: #ffe0e0;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 24px;
            }

            .error-code {
                font-size: 80px;
                font-weight: 700;
                color: #dc3545;
                line-height: 1;
            }
    </style>
</head>

<body>
    <div class="container vh-100 d-flex justify-content-center align-items-center">
        <div class="text-center">

            <!-- Icon -->
            <div class="icon-circle">
                <i class="bi bi-shield-lock-fill text-danger"
                   style="font-size: 56px;"></i>
            </div>

            <!-- Error code -->
            <div class="error-code">403</div>

            <!-- Title -->
            <h2 class="mt-2 fw-bold">Access Denied!</h2>

            <!-- Message -->
            <p class="text-muted mt-2 mb-4">
                Sorry, you don't have permission to access this page. <br />
                Please contact your administrator if you think this is a mistake.
            </p>

            <!-- Buttons -->
            <div class="d-flex gap-3 justify-content-center">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary px-4">
                    <i class="bi bi-house me-2"></i>Go Home
                </a>

               

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="btn btn-outline-danger px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>LogOut
                </a>

            </div>

        </div>
    </div>

</body>
</html>