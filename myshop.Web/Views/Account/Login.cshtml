@using myshop.Web.ViewModels

@model LoginVM

@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <style>
            body {
                background: #f4f6f9;
            }

            .login-card {
                width: 420px;
                border: none;
                border-radius: 15px;
            }

            .card-header-custom {
                text-align: center;
                font-weight: bold;
                font-size: 28px;
            }
    </style>
</head>

<body>
    @if (@ViewBag.RegisteredSuccessfully)
        {
   <div class="modal" id="exampleModal" tabindex="-1" aria-hidden="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-success">

         
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="bi bi-check-circle-fill me-2"></i>Success!
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

          
            <div class="modal-body text-center py-4">
                <i class="bi bi-person-check-fill text-success"
                   style="font-size: 48px;"></i>
                <h5 class="mt-3">Account Created Successfully!</h5>
                <p class="text-muted">@ViewBag.massage</p>
            </div>

           
            <div class="modal-footer justify-content-center">
                        <button class="btn btn-success" data-bs-dismiss="modal">
                    <i class="bi bi-box-arrow-in-right me-1"></i>
                    Close
                </button>
            </div>

        </div>
    </div>
</div>


    }

    <div class="container vh-100 d-flex justify-content-center align-items-center">
        <form method="post" asp-action="Login">

        <div class="card login-card shadow-lg">

            <div class="card-body p-4">
   

                <div class="card-header-custom mb-4">
                    <i class="bi bi-person-circle fs-1 text-primary"></i>
                    <div>Login</div>
                </div>
                    @if ((bool)TempData["FailedToLogFlag"])

                    {

                        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">

                           
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-circle-fill fs-5"></i>
                                <strong>@TempData["msg"]</strong>
                            </div>

                           
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>

                        </div>

                                                        

    
                    }

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">Username or Email</label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-person"></i>
                        </span>

                        <input type="text"
                               class="form-control"
                               asp-for="UserName"
                               placeholder="example@email.com">
                    </div>
                        <span class="text-danger" asp-validation-for="UserName"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input id="PassInput" type="password"
                               class="form-control"
                               asp-for="Password"
                               placeholder="Enter Password">
                    </div>
                        <span asp-validation-for="Password" class="text-danger"></span>

                </div>
                <div class="row mb-4">
                    <div class="col-md-6">
                        Show Password
                        <input id="TransformPassToTxt" type="checkbox" class="form-check-input ms-2" />
                    </div>

                    <div class="col-md-6">
                        Remember me
                        <input asp-for="RememberMe" type="checkbox" class="form-check-input ms-2" />
                           


                    </div>
              
                </div>
              
                <div class="d-grid gap-2">

                    <button class="btn btn-primary">
                        Login
                        <i class="bi bi-box-arrow-in-right"></i>
                    </button>

                    <div class="text-center text-muted fw-bold">
                        Or
                    </div>

                    <a class="btn btn-outline-secondary" asp-action="SignUp">
                        Register
                    </a>

                </div>

            </div>

        </div>
        </form>
    </div>
    @if (ViewBag.LockoutFlagMsgAppear)
    {
        <div class="toast-container position-fixed top-0 end-0 p-4">
            <div id="lockoutToast"
                 class="toast border-0 shadow-lg"
                 role="alert"
                 aria-live="assertive"
                 aria-atomic="true">

                <div class="toast-header bg-warning text-dark border-0">
                    <span class="fs-5 me-2">🔒</span>
                    <strong class="me-auto">Account Status</strong>
                    <small class="text-dark opacity-75">Now</small>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="toast"
                            aria-label="Close">
                    </button>
                </div>

                <div class="toast-body bg-light text-dark py-3 px-4">
                    @ViewBag.LockOutMsgResult
                </div>
            </div>
        </div>

         
       
    }

    @if (ViewBag.RoleFlagChanged)
    {

    


        <div class="toast-container position-fixed top-0 end-0 p-4">
            <div id="roleToast"
                 class="toast border-0 shadow-lg"
                 role="alert"
                 aria-live="assertive"
                 aria-atomic="true">

                <div class="toast-header bg-warning text-dark border-0">

                    <strong class="me-auto">Account Role</strong>
                    <small class="text-dark opacity-75">Now</small>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="toast"
                            aria-label="Close">
                    </button>
                </div>

                <div class="toast-body bg-light text-dark py-3 px-4">
                    @ViewBag.RoleMsgIfChanged
                </div>
            </div>
        </div>

         
       
    }
 

</body>
</html>
<script>
    let checkbox = document.getElementById("TransformPassToTxt");
    let passwordInput = document.getElementById("PassInput");
    checkbox.addEventListener("change", function() {
        if (this.checked) {
            passwordInput.type = "text";
        } else {
            passwordInput.type = "password";
        }
    });

</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        new bootstrap.Modal(
            document.getElementById('exampleModal')
        ).show()
    })
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var toastEl = document.getElementById("lockoutToast");

        if (toastEl) {
            var toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    });
</script>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        var toastEl = document.getElementById("roleToast");

        if (toastEl) {
            var toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    });
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>