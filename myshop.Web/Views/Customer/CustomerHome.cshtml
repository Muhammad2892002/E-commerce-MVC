@model List<ProductVM>;
@{

    Layout = "_Customer";

}
<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
   

</head>
<body>
    <section class="container my-4">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body">
                <div class="row g-3 align-items-end">

                    <!-- Search -->
                    <div class="col-12 col-lg-5">
                        <label for="searchInput" class="form-label fw-semibold">Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input id="title-search" type="text" id="searchInput" class="form-control" placeholder="Search by title..." />
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="col-6 col-lg-3">
                        <label for="categorySelect" class="form-label fw-semibold">Category</label>
                        <select id="categorySelect" class="form-select">
                            <option value="" selected>All Categories</option>
                            <option>RAMs</option>
                            <option>CPU</option>
                            <option>Laptops</option>
                            <option>Apple Products</option>
                        </select>
                    </div>

                    <!-- Sort -->
                    <div class="col-6 col-lg-3">
                        <label for="sortSelect" class="form-label fw-semibold">Sort By</label>
                        <select id="sortSelect" class="form-select">
                            <option disabled selected value="" selected>Select...</option>
                            <option value="name-asc">Name (A-Z)</option>
                            <option value="name-desc">Name (Z-A)</option>
                            <option value="price-asc">Price (Low → High)</option>
                            <option value="price-desc">Price (High → Low)</option>
                        </select>
                    </div>

                    <!-- Reset -->
                    <div class="col-12 col-lg-1 d-grid">
                        <button id="resetBtn" class="btn btn-outline-secondary" title="Reset filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <!-- Results count -->
        <p id="resultsCount" class="text-muted mt-3 mb-0"></p>
    </section>

    <!-- Put this where your products are rendered -->
    <div id="noResults" class="text-center text-muted my-5 d-none">
        <i class="bi bi-search fs-1"></i>
        <p class="mt-2">No products found. Try a different search.</p>
    </div>
 
    <div id="container" class="row mt-4 mx-2 g-4">
        @foreach(var result in Model){
        <div class="col-md-4 col-sm-6">
            <div class="card product-card h-100 border-0 shadow-sm">
                <div class="product-img-wrapper">
                    <img src="~/@result.Img" class="card-img-top product-img" alt="@result.Name" />
                </div>
                <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-1">@result.Name}</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        @result.Description
                    </p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold fs-5 text-success">@result.Price</span>
                        <span class="badge bg-light text-dark border">In Stock</span>
                    </div>
                    <form method="post" asp-action="AddCart" asp-controller="Cart">
                        <input type="hidden" name="productId" value="@result.Id" />
                        <button type="submit" class="btn btn-outline-success w-100">
                            <i class="bi bi-cart2 me-2"></i>Add to Cart
                        </button>
                    </form>

                </div>
            </div>
        </div>
        
        
        }
       

     
    </div>
    <div class=" mt-3 ms-4">


        <nav aria-label="Page navigation example">
            <ul class="pagination">
                <li class="page-item">
                    <a class="page-link" href="#" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                <li class="page-item"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>

    </div>
  

   

</body>
<script>
    let selectFilter = document.getElementById("sortSelect");
    let selectedArr;
    console.log(selectedArr);
    if(selectedArr===undefined){
     selectedArr = @Html.Raw(Json.Serialize(Model));
    }
    else{
 console.log(selectedArr);
}

    selectFilter.addEventListener("change",filterByName);
    function filterByName(){
       
        let filterByNameResult=selectFilter.value;
        switch(filterByNameResult){
            case "name-asc":{
                ProductsConatiner.innerHTML="";
             
                let sortedArray = selectedArr.sort((a, z) =>
                    a.name.trim().toUpperCase().localeCompare(z.name.trim().toUpperCase())
                );
                selectedArr=sortedArray;
                console.log("Sorted:");
                console.log(selectedArr);
                selectedArr.forEach(ele => {
                   console.log(ele);
                    RenderData(ele)});
                break;
                
            
            
            }
            case "name-desc": {
                ProductsConatiner.innerHTML = "";

                let sortedArray = selectedArr.sort((a, z) =>
                    z.name.trim().toUpperCase().localeCompare(a.name.trim().toUpperCase())
                );
                selectedArr=sortedArray;
                selectedArr.forEach(ele => {
                    console.log(ele);
                    RenderData(ele)
                });
                break;

                
            
            }


               case "price-asc":{
                ProductsConatiner.innerHTML="";
             
                let sortedArray = selectedArr.sort((a, z) =>
                    a.price-z.price
                );
                selectedArr=sortedArray;
                console.log("Sorted:");
                console.log(selectedArr);
                selectedArr.forEach(ele => {
                   console.log(ele);
                    RenderData(ele)});
                break;
                
            
            
            }
            case "price-desc": {
                ProductsConatiner.innerHTML = "";

                let sortedArray = selectedArr.sort((a, z) =>
                    z.price-a.price
                );
                selectedArr=sortedArray;
                selectedArr.forEach(ele => {
                    console.log(ele);
                    RenderData(ele)
                });
                break;

                
            
            }
        }
    
    }

    let searchByTitle = document.getElementById("title-search");
    let ProductsConatiner = document.getElementById("container");
    
    searchByTitle.addEventListener("input",()=>{
    
        testEvent(searchByTitle.value);
    });
   async function testEvent(obj){
     
        selectedArr = await fetch(`/Customer/SearchProducts?searchByTitle=${searchByTitle.value}`).then(res => res.json());
        ProductsConatiner.innerHTML="";
        selectedArr.forEach(data => {
            RenderData(data)
        });

       
    }

    function RenderData(objProduct){
        console.log(objProduct);
        let addCartUrl = '@Url.Action("AddCart", "Cart")';
        ProductsConatiner.insertAdjacentHTML("beforeend",`  <div class="col-md-4 col-sm-6">
                    <div class="card product-card h-100 border-0 shadow-sm">
                        <div class="product-img-wrapper">
                                <img src="/${objProduct.img}" class="card-img-top product-img" alt="${objProduct.name}" />
                        </div>
                        <div class="card-body d-flex flex-column">
                                <h5 class="card-title mb-1">${objProduct.name}</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                    ${objProduct.description}
                            </p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fw-bold fs-5 text-success">${objProduct.price}</span>
                                <span class="badge bg-light text-dark border">In Stock</span>
                            </div>
                            <form method="post" action="${addCartUrl}">
                                    <input type="hidden" name="productId" value="${objProduct.id}" />
                                <button type="submit" class="btn btn-outline-success w-100">
                                    <i class="bi bi-cart2 me-2"></i>Add to Cart
                                </button>
                            </form>

                        </div>
                    </div>
                </div>`);

        
    
    
    
    }

</script>

</html>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>