@model List<ProductVM>;
@{

    Layout = "_Customer";

}
<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
   

</head>
<body>
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body m-3">
            <div class="row g-3 align-items-end">

                <!-- Sort -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-funnel-fill"></i> Sort By
                    </label>
                    <select class="form-select">
                        <option selected>Select...</option>
                        <option>Name (A-Z)</option>
                        <option>Name (Z-A)</option>
                        <option>Price (Low → High)</option>
                        <option>Price (High → Low)</option>
                    </select>
                </div>

                <!-- Product Name -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Product Name
                    </label>
                    <input type="text"
                           class="form-control"
                           placeholder="Search by name">
                </div>

                <!-- Description -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Description
                    </label>
                    <input type="text"
                           class="form-control"
                           placeholder="Search by description">
                </div>

                <!-- Category -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Category
                    </label>
                    <select class="form-select">
                        <option selected>All Categories</option>
                        <option>RAMs</option>
                        <option>CPU</option>
                        <option>Laptops</option>
                        <option>Apple Products</option>
                    </select>
                </div>

            </div>

            <div class="mt-4 d-flex justify-content-end gap-2">
                <button type="reset" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </button>

                <button class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </div>
    </div>
 
    <div class="row mt-4 mx-2 g-4">
        @foreach (var product in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card product-card h-100 border-0 shadow-sm">
                    <div class="product-img-wrapper">
                        <img src="~/@product.Img" class="card-img-top product-img" alt="@product.Name" />
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-1">@product.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            @product.Description
                        </p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold fs-5 text-success">@product.Price</span>
                            <span class="badge bg-light text-dark border">In Stock</span>
                        </div>
                        <form method="post" asp-action="AddCart" asp-controller="Cart">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button type="submit" class="btn btn-outline-success w-100">
                                <i class="bi bi-cart2 me-2"></i>Add to Cart
                            </button>
                        </form>
                      
                    </div>
                </div>
            </div>
        }

     
    </div>
    <div class=" mt-3 ms-4">


        <nav aria-label="Page navigation example">
            <ul class="pagination">
                <li class="page-item">
                    <a class="page-link" href="#" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                <li class="page-item"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>

    </div>
  

   

</body>

</html>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>