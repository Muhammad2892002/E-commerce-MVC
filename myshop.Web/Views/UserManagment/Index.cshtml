
@{
 
    Layout = "_Dashboard";

}
@using myshop.Web.ViewModels
@model List<DisplayUserVM>
<style>
    .custom-card {
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(12px);
        border-radius: 18px;
        border: 1px solid rgba(160,173,186,.35);
        box-shadow: 0 15px 35px rgba(0,0,0,.12);
        padding: 28px;
        animation: fadeIn .4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-card-title {
        background: linear-gradient(135deg,#1e3a8a,#3b82f6);
        padding: 18px;
        border-radius: 14px;
        margin-bottom: 22px;
        text-align: center;
        color: white;
        font-weight: 700;
        letter-spacing: .6px;
        font-size: 22px;
        box-shadow: 0 4px 20px rgba(30,58,138,.35);
    }

    .top-btn {
        margin-bottom: 18px;
        text-align: right;
    }

    .btn-primary {
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg,#1e40af,#2563eb);
        color: white;
        box-shadow: 0 6px 20px rgba(37,99,235,.35);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg,#1e3a8a,#1d4ed8);
            transform: translateY(-2px);
        }

    #mytable thead th {
        background: #1e40af !important;
        color: white !important;
        padding: 14px !important;
        border: none !important;
    }

    #mytable tbody td {
        background: white !important;
        padding: 14px !important;
        color: #1e3a8a;
        border-bottom: 1px solid #e3e8ef !important;
    }

    #mytable tbody tr:hover td {
        background: #ebf2ff !important;
    }

    .action-btn {
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-success {
        background: #16a34a;
        color: white;
        border: none;
    }

    .btn-danger {
        background: #dc2626;
        color: white;
        border: none;
    }
</style>

<div class="custom-card">
    <div >
        <h5 class="custom-card-title">
            <i class="bi bi-table"></i> Users List
        </h5>
    </div>


    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="mytable" class="display table-hover" width="100%">
                <thead >
                    <tr>

                        <th>User name</th>
                        <th>Email</th>
                        <th>Current Role</th>
                        <th width="120">Lock status</th>
                        <th width="160" class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>

                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>@user.CurrentRole</td>
                            @if (user.LockStatus)
                            {
                                <td>
                                    <span class="badge bg-success">Active</span>
                                </td>

                            }
                            else
                            {
                                <td>
                                    <span class="badge bg-danger">Not active</span>
                                </td>
                            }
                            @if (user.CurrentRole == "Admin")
                            {
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">

                                        <!-- Demote Button -->
                                        <a class="btn btn-sm btn-outline-danger"
                                           asp-action="DemoteUser"
                                           asp-route-Id="@user.Id">
                                            <i class="bi bi-arrow-down-circle me-1"></i>Demote
                                        </a>

                                        <!-- Lock/Unlock Button -->
                                        @if (user.LockStatus == true)
                                        {
                                            <a class="btn btn-sm btn-outline-warning"
                                               asp-action="LockUser"
                                               asp-route-Id="@user.Id">
                                                <i class="bi bi-lock-fill me-1"></i>Lock
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-primary text-white"
                                               asp-action="UnlockUser"
                                               asp-route-Id="@user.Id">
                                                <i class="bi bi-unlock-fill me-1"></i>Unlock
                                            </a>
                                        }

                                    </div>
                                </td>
                            }
                            else
                            {
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">

                                        <!-- Promote Button -->
                                        <a class="btn btn-sm btn-outline-success"
                                           asp-action="PremoteUser"
                                           asp-route-Id="@user.Id">
                                            <i class="bi bi-arrow-up-circle me-1"></i>Promote
                                        </a>

                                        <!-- Lock/Unlock Button -->
                                        @if (user.LockStatus == true)
                                        {
                                            <a class="btn btn-sm btn-outline-warning"
                                               asp-action="LockUser"
                                               asp-route-Id="@user.Id">
                                                <i class="bi bi-lock-fill me-1"></i>Lock
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-primary text-white"
                                               asp-action="UnlockUser"
                                               asp-route-Id="@user.Id">
                                                <i class="bi bi-unlock-fill me-1"></i>Unlock
                                            </a>
                                        }

                                    </div>
                                </td>
                            }

                           

                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
@if (ViewBag.LockoutFlagMsgAppear)
{

    <div class="toast-container position-fixed top-0 end-0 p-4">
        <div id="lockoutToast"
             class="toast border-0 shadow-lg"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="toast-header bg-warning text-dark border-0">
                <span class="fs-5 me-2">🔒</span>
                <strong class="me-auto">Account Status</strong>
                <small class="text-dark opacity-75">Now</small>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="toast"
                        aria-label="Close">
                </button>
            </div>

            <div class="toast-body bg-light text-dark py-3 px-4">
                @ViewBag.LockOutMsgResult
            </div>
        </div>
    </div>

         
       
}
@if (ViewBag.RoleFlagChanged)
{

    


    <div class="toast-container position-fixed top-0 end-0 p-4">
        <div id="roleToast"
             class="toast border-0 shadow-lg"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="toast-header bg-warning text-dark border-0">
               
                <strong class="me-auto">Account Role</strong>
                <small class="text-dark opacity-75">Now</small>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="toast"
                        aria-label="Close">
                </button>
            </div>

            <div class="toast-body bg-light text-dark py-3 px-4">
                @ViewBag.RoleMsgIfChanged
            </div>
        </div>
    </div>

         
       
}




<script>
    document.addEventListener("DOMContentLoaded", function () {
        var toastEl = document.getElementById("lockoutToast");

        if (toastEl) {
            var toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var toastEl = document.getElementById("roleToast");

        if (toastEl) {
            var toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>