

@model List<Cart>
@{

    Layout = "_Customer";
    decimal productPrice = 0;
    decimal subTotal = 0;
    decimal shipping=0;
    decimal tax=0;
    if (Model.Count >0)
    {

        shipping = 2;
        tax = 2;
    }
    decimal total = 0;


}
<head>
    <style>
            .cart-page .card {
                border-radius: 12px;
                overflow: hidden;
            }

            .cart-item {
                border-bottom: 1px solid #eee;
                transition: background-color 0.15s ease;
            }

                .cart-item:last-child {
                    border-bottom: none;
                }

                .cart-item:hover {
                    background-color: #fafafa;
                }

            .product-thumb {
                object-fit: cover;
                aspect-ratio: 1 / 1;
                width: 100%;
            }

            .remove-btn {
                font-size: 0.8rem;
            }

            .item-price {
                font-size: 1.05rem;
                color: #212529;
            }

            .qty-stepper .form-control {
                max-width: 45px;
                border-left: none;
                border-right: none;
            }

            .sticky-checkout {
                position: sticky;
                top: 20px;
            }

            @@media (max-width: 767px) {
                .sticky-checkout {
                    position: static;
                }
            }
    </style>
</head>
<body>
    <div class="row cart-page">
        <div>
            <a asp-action="ClearCart" class="btn btn-outline-danger">Clear all Products</a>
        </div>
        <!-- Cart Items -->
        <div class="col-md-8 all-product-in-cart">
            <div class="card shadow-sm mb-3 border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold">Shopping Cart</h5>
                    <span class="badge bg-light text-dark border">@Model.Count</span>
                </div>
                <div class="card-body p-0">

                    <!-- Repeat this block per cart item -->
                    @foreach (var product in Model)
                        {
                            <div class="row align-items-center cart-item mx-0 px-3 py-3">
                                <div class="col-md-3 col-4">
                                    <img src="~/@product.ImageUrl"
                                    class="img-fluid rounded product-thumb" alt="Product image" />
                                </div>

                                <div class="col-md-5 col-8">
                                    <h6 class="mb-1 fw-semibold">@product.ProductName</h6>
                                    <p class="text-muted small mb-2">
                                        @product.Description
                                    </p>
                                    <a class="btn btn-link btn-sm text-danger p-0 remove-btn" type="button" asp-route-Id="@product.ProductId"
                                   asp-action="RemoveItem">
                                        <i class="bi bi-trash"></i> Remove
                                    </a>
                                </div>

                                <div class="col-md-2 col-6 mt-3 mt-md-0">
                                    <div class="input-group input-group-sm qty-stepper">
                                    <button class="btn btn-outline-secondary decrease-btn decreaseQuantity" data-ProductId="@product.ProductId" type="button">−</button>
                                        <input disabled id="@product.ProductId"  type="text" class="form-control text-center" value="@product.Quantity"  />
                                    <button data-ProductId="@product.ProductId"  class="btn btn-outline-secondary IncreaseQuantity" type="button">+</button>
                                    </div>
                                </div>

                                <div class="col-md-2 col-6 mt-3 mt-md-0 text-md-end text-start">
                                    <strong class="item-price">@product.Price</strong>
                                </div>
                            </div>
                            
                                productPrice = product.Quantity * product.Price;
                                subTotal += productPrice;

                                
                            
                            
                            


                        }
                        <!-- End repeat: duplicate ONLY the block above, not the whole card -->

                </div>
            </div>

            <a href="#" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Continue Shopping
            </a>
        </div>

        <!-- Checkout Summary -->
        <div class="col-md-4 check-out">
            <div class="card shadow-sm border-0 sticky-checkout">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2 text-secondary">
                        <span>Subtotal</span>
                        <span>@subTotal</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-secondary">
                        <span>Shipping</span>
                        <span>@shipping</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-secondary">
                        <span>Tax</span>
                        <span>@tax</span>
                    </div>
                    <hr />
                        @{
                            total = subTotal + shipping + tax;

                        }
                        @if (Model.Count() == 0)
                        {
                            total = 0;
                            shipping = 0;
                            tax = 0;

                        }
                        <div class="d-flex justify-content-between mb-3">
                        <strong>Total</strong>
                        <strong class="text-primary fs-5">@total</strong>
                    </div>

                    <button class="btn btn-primary w-100 py-2" type="submit">
                        Proceed to Checkout
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
<script>
    document.addEventListener("DOMContentLoaded",function(){
        
        var increamentBtn = document.querySelectorAll(".IncreaseQuantity");
        var DecrementBtn = document.querySelectorAll(".decreaseQuantity");
        // var showIndex = document.getElementById("IndexDisplay");
        increamentBtn.forEach(function(btn) {

            btn.addEventListener("click", function(e) {
                console.log(`this is Id${e.target.dataset.productid}`);
                incrementIndex(e.target.dataset.productid);
            });   

        });       

        DecrementBtn.forEach(function(btn) {

            btn.addEventListener("click", function(e) {
                console.log(`this is Id${e.target.dataset.productid}`);
                DecrementIndex(e.target.dataset.productid);
            });

        });
       
       
     
 
       

        function incrementIndex(index){
            var showIndex = document.getElementById(`${index}`);
 console.log(showIndex.value);
          
            if(showIndex.value<10){
           increamentBtn.disabled = false;
                DecrementBtn.disabled = false;
            showIndex.value++;
                increaseQuantity(showIndex.value,index);
            }
            else{
            increamentBtn.disabled=true
            DecrementBtn.disabled=false;
            }
           
            
        
        
        
        }


        function DecrementIndex(Index) {
            var showIndex = document.getElementById(`${Index}`);
            console.log(showIndex.value);
if(showIndex.value<=1){
             
            DecrementBtn.disabled=true;
            }

            if(showIndex.value<=10 && showIndex.value>1){
             increamentBtn.disabled=false;
             DecrementBtn.disabled=false;
             showIndex.value--;
                DecreaseQuantity(showIndex.value,Index);
            }
            
           
           

            
        
        
        }

        function increaseQuantity(Quantity,ProductId){
         
            fetch(`/Cart/IncreaseQuantity`,{
             
                method:"POST",
                headers:{"Content-Type":"application/json"},
              body: JSON.stringify({
                    productId:ProductId,
                    quantity:Quantity
              
              
              })
               
            }).then(response => {
                if (response.ok) {
                    location.reload();

            
                }

            
            }).catch(err => console.log(err));
        
        }


        function DecreaseQuantity(Quantity, ProductId) {

            fetch(`/Cart/DecreaseQuantity`, {

                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    productId: ProductId,
                    quantity: Quantity

              
                })

               
            }).then(response=>{
            if(response.ok){
             location.reload();
            
            
            }
            
            
            }).catch(err=>console.log(err));

        }

        

    
    
    });
</script>
