@model List<ProductVM>;

@{
    ViewBag.PageTitle = "Products Management";
    ViewBag.CardTitle = "View Products";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<style>
    .custom-card {
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(12px);
        border-radius: 18px;
        border: 1px solid rgba(160,173,186,.35);
        box-shadow: 0 15px 35px rgba(0,0,0,.12);
        padding: 28px;
        animation: fadeIn .4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-card-title {
        background: linear-gradient(135deg,#1e3a8a,#3b82f6);
        padding: 18px;
        border-radius: 14px;
        margin-bottom: 22px;
        text-align: center;
        color: white;
        font-weight: 700;
        letter-spacing: .6px;
        font-size: 22px;
        box-shadow: 0 4px 20px rgba(30,58,138,.35);
    }

    .top-btn {
        margin-bottom: 18px;
        text-align: right;
    }

    .btn-primary {
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg,#1e40af,#2563eb);
        color: white;
        box-shadow: 0 6px 20px rgba(37,99,235,.35);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg,#1e3a8a,#1d4ed8);
            transform: translateY(-2px);
        }

    #mytable thead th {
        background: #1e40af !important;
        color: white !important;
        padding: 14px !important;
        border: none !important;
    }

    #mytable tbody td {
        background: white !important;
        padding: 14px !important;
        color: #1e3a8a;
        border-bottom: 1px solid #e3e8ef !important;
    }

    #mytable tbody tr:hover td {
        background: #ebf2ff !important;
    }

    .action-btn {
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-success {
        background: #16a34a;
        color: white;
        border: none;
    }

    .btn-danger {
        background: #dc2626;
        color: white;
        border: none;
    }
</style>

<div class="custom-card">

    <div class="custom-card-title">
        <i class="fa-solid fa-box-open me-2"></i>
        Products List
    </div>

    <div class="top-btn">
        <a asp-controller="Product" asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-circle-plus me-1"></i>
            Create Product
        </a>
    </div>

    <table id="mytable" class="display table-hover" width="100%">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th style="width:130px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price</td>
                    <td>@product.CategoryName</td>
                    <td>
                        <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@product.Id">
                            <i class="bi bi-pen"></i>
                        </a>
                        <a class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@product.Id">
                            <i class="bi bi-trash-fill"></i>
                        </a>
                    </td>
                </tr>
               @*  DeleteModal *@

                <!-- Button trigger modal -->
               

            
            }
        </tbody>
    </table>

</div>

<!-- Modal -->
@foreach (var item in Model)
{
    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@item.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg,#dc2626,#ef4444); color: white; border-radius: 18px 18px 0 0;">
                    <h5 class="modal-title" id="deleteModalLabel-@item.Id">
                        <i class="fa-solid fa-trash-can me-2"></i>Delete Product Confirmation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
                </div>
                <div class="modal-body" style="padding: 24px;">
                    <div class="text-center mb-3">
                        <i class="fa-solid fa-triangle-exclamation" style="font-size: 48px; color: #dc2626;"></i>
                    </div>
                    <h5 class="text-center mb-3">Are you sure you want to delete this product?</h5>
                    <div style="background: #fef2f2; border-radius: 10px; padding: 16px; border: 1px solid #fecaca;">
                        <p class="mb-1"><strong>Product Name:</strong> @item.Name</p>
                        <p class="mb-1"><strong>Description:</strong> @item.Description</p>
                        <p class="mb-0"><strong>Price:</strong> $@item.Price</p>
                    </div>
                    <p class="text-muted mt-3 small">
                        <i class="fa-solid fa-info-circle me-1"></i>
                        This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer" style="padding: 16px 24px; border-top: 1px solid #e3e8ef;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa-solid fa-times me-1"></i> Cancel
                    </button>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display: inline;">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash-can me-1"></i> Delete Product
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
@*  /////////////////////////// End Modal *@